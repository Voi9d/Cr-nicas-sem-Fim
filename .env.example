# Copie este arquivo para .env e ajuste as opções desejadas.
# O arquivo .env contém segredos e não deve ser enviado ao GitHub.

# Provedor de IA: "ollama" (padrão, local) ou "gemini" (API do Google)
PROVEDOR_IA=gemini

# ----- Ollama -----
# Modelo precisa estar instalado localmente: ollama pull llama3.1
MODELO=llama3.1
# Endereço local do Ollama
OLLAMA_URL=http://127.0.0.1:11434
# Contexto em tokens; valores maiores consomem mais memória
CONTEXTO=8192

# ----- Gemini API -----
# Crie uma chave no Google AI Studio e cole apenas no arquivo .env
# Para usar Gemini, altere PROVEDOR_IA=gemini
GEMINI_API_KEY=SUA_CHAVE_AQUI
# Modelo Gemini utilizado pelo projeto
GEMINI_MODELO=gemini-3.5-flash-lite

# Porta do site
PORT=3000
